+"""Lightweight Flet package init for application runtime and Nuitka builds.
+
+This project imports Flet controls from submodules directly, so we avoid
+loading the original package-wide re-export surface here. That original init
+pulls in the massive Material/Cupertino icon enums and many unrelated modules,
+which bloats Nuitka analysis substantially.
+"""
+
+__all__ = []
